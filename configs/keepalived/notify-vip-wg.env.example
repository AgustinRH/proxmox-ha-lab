# Copy to /etc/keepalived/notify-vip-wg.env on each webdb-* (chmod 640).
# Example values only — replace keys and adjust LOCAL_* per site.

WG_IF=wg0
VIP_HOST=10.99.0.10
VIP=10.99.0.10/32

# This VM's site and services address (change per webdb)
LOCAL_SITE=a
LOCAL_WEBDB=10.10.40.21

# This site's router (VIP host route → LOCAL_WEBDB on services VLAN)
LOCAL_ROUTER_SSH=root@10.10.10.1

# Remote site WireGuard gateways only (AllowedIPs + route via our WG peer)
# On webdb-a1 / LOCAL_SITE=a:
GATEWAYS="root@10.20.10.1 root@10.30.10.1"

PEER_A_PUBKEY=<PUBLIC_KEY_A>
PEER_B_PUBKEY=<PUBLIC_KEY_B>
PEER_C_PUBKEY=<PUBLIC_KEY_C>
PEER_A_WG=10.255.50.1
PEER_B_WG=10.255.50.2
PEER_C_WG=10.255.50.3
PEER_A_BASE=10.10.10.0/24,10.10.20.0/24,10.10.30.0/24,10.10.40.0/24
PEER_B_BASE=10.20.10.0/24,10.20.20.0/24,10.20.30.0/24,10.20.40.0/24
PEER_C_BASE=10.30.10.0/24,10.30.20.0/24,10.30.30.0/24,10.30.40.0/24
