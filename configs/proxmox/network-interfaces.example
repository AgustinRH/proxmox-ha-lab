# Proxmox VE host networking — /etc/network/interfaces
# Node example: pve-a (Site A). For pve-b / pve-c swap in 10.20.* / 10.30.*.
#
# No bonding in this example: a single-slave 802.3ad bond is invalid.
# NIC0 (eno1) = mgmt + services; NIC1 (eno2) = cluster + storage.
# After editing: ifreload -a  (or reboot in a window)

auto lo
iface lo inet loopback

auto eno1
iface eno1 inet manual
# 10GbE — mgmt + services trunk

auto eno2
iface eno2 inet manual
# 10GbE — cluster + storage trunk

# --- VLAN 10: management ---
auto eno1.10
iface eno1.10 inet manual
        vlan-raw-device eno1

auto vmbr10
iface vmbr10 inet static
        address 10.10.10.11/24
        gateway 10.10.10.1
        bridge-ports eno1.10
        bridge-stp off
        bridge-fd 0
# UI: https://10.10.10.11:8006

# --- VLAN 40: services (app VMs) ---
auto eno1.40
iface eno1.40 inet manual
        vlan-raw-device eno1

auto vmbr40
iface vmbr40 inet manual
        bridge-ports eno1.40
        bridge-stp off
        bridge-fd 0
# Attach webdb-a1 to vmbr40 → 10.10.40.21

# --- VLAN 20: Corosync / cluster ---
auto eno2.20
iface eno2.20 inet manual
        vlan-raw-device eno2

auto vmbr20
iface vmbr20 inet static
        address 10.10.20.11/24
        bridge-ports eno2.20
        bridge-stp off
        bridge-fd 0

# --- VLAN 30: storage / PBS ---
auto eno2.30
iface eno2.30 inet manual
        vlan-raw-device eno2

auto vmbr30
iface vmbr30 inet static
        address 10.10.30.11/24
        bridge-ports eno2.30
        bridge-stp off
        bridge-fd 0
# pbs-a example: 10.10.30.21
