# Corosync / knet-style EXAMPLE for a 3-node Proxmox cluster
#
# DO NOT hand-edit a live cluster's corosync.conf to "make it look like this".
# Create/join nodes with pvecm (or the Datacenter UI). Use this file only as a
# readable reference of roles and ring0 addresses from docs/architecture.md.
#
# Live paths are typically /etc/pve/corosync.conf (replicated) and
# /etc/corosync/corosync.conf on each node.

logging {
  debug: off
  to_syslog: yes
}

nodelist {
  node {
    name: pve-a
    nodeid: 1
    quorum_votes: 1
    # Site A cluster VLAN
    ring0_addr: 10.10.20.11
  }
  node {
    name: pve-b
    nodeid: 2
    quorum_votes: 1
    ring0_addr: 10.20.20.11
  }
  node {
    name: pve-c
    nodeid: 3
    quorum_votes: 1
    ring0_addr: 10.30.20.11
  }
}

quorum {
  provider: corosync_votequorum
  # Do not hard-code expected_votes here for day-2 ops; let the cluster
  # manage votes via pvecm. With 3 nodes, majority is 2 while all are up.
}

totem {
  version: 2
  cluster_name: lab-pve
  # Modern Proxmox releases use knet transport by default when created via pvecm
  transport: knet
  interface {
    linknumber: 0
  }
}
